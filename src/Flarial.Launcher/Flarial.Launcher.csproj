<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>

        <Platforms>x64</Platforms>
        <PlatformTarget>x64</PlatformTarget>

        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <NoWarn>IL2026,IL2104</NoWarn>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <DeterministicSourcePaths>true</DeterministicSourcePaths>

        <ApplicationIcon>Resources/app.ico</ApplicationIcon>
        <ApplicationManifest>Resources/app.manifest</ApplicationManifest>

        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <PropertyGroup Condition="$(Configuration) == 'Release'">
        <Optimize>true</Optimize>
        <PublishReadyToRun>true</PublishReadyToRun>
        <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    </PropertyGroup>

    <PropertyGroup>
        <SelfContained>true</SelfContained>

        <PublishRelease>true</PublishRelease>
        <PublishTrimmed>true</PublishTrimmed>

        <UseSizeOptimizedLinq>true</UseSizeOptimizedLinq>
        <InvariantGlobalization>true</InvariantGlobalization>

        <DebuggerSupport>false</DebuggerSupport>
        <EventSourceSupport>false</EventSourceSupport>
        <MetadataUpdaterSupport>false</MetadataUpdaterSupport>

        <Http3Support>false</Http3Support>
        <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>

        <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
        <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
        <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Resources\**" />
        <AvaloniaResource Remove="Resources\app.manifest" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Assets\**\*.png" />
        <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <PropertyGroup>
        <EnableMsixTooling>true</EnableMsixTooling>
        <UseSdkBuildToolsPackage>true</UseSdkBuildToolsPackage>

        <AppxPackageName>$(AssemblyName)</AppxPackageName>

        <WindowsPackageType>MSIX</WindowsPackageType>
        <PublishAppxPackage>true</PublishAppxPackage>

        <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
        <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Flarial.Runtime\Flarial.Runtime.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.Reactive" Version="7.0.0" />

        <PackageReference Include="SkiaSharp" Version="4.150.1" />
        <PackageReference Include="Avalonia.Skia" Version="12.1.1" />

        <PackageReference Include="Avalonia.Win32" Version="12.1.1" />
        <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.1" />

        <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.0" />
        <PackageReference Include="ReactiveUI.SourceGenerators" Version="3.1.0" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.260610101" />
    </ItemGroup>

</Project>